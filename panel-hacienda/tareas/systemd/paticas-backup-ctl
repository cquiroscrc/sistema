#!/bin/bash
# Comando forzado SSH (via paticas-backup-ssh): timer/servicio del respaldo de inventario y
# mantenimiento de archivos. Nombres validados: solo inventario_YYYYMMDD_HHMM.bak, sin rutas.
#   status | enable | disable | start | log
#   schedule <token>   (diaria:HH:MM | intervalo:minutos:N | intervalo:horas:N | semanal:Mon:HH:MM)
#   files | download <nombre> | delete <nombre>                       (local: /var/opt/mssql/backup)
#   espacio | mega-espacio                                          (uso de disco / cuota MEGA)
#   mega-status | mega-files | mega-download <nombre> | mega-delete <nombre>  (MEGA: /Respaldos/inventario)
#   retencion | retencion-set <local>:<mega>     (dias a mantener, enteros 1-365; aplica en la proxima corrida, no borra nada)
set -euo pipefail
CMD="${SSH_ORIGINAL_COMMAND:-${1:-}}"
CMD=$(printf '%s' "$CMD" | tr -d '\r\n')
read -r ACC NOMBRE EXTRA <<< "$CMD" || true
ACC="${ACC:-}"; NOMBRE="${NOMBRE:-}"; EXTRA="${EXTRA:-}"
DIR=/var/opt/mssql/backup
MEGA_DIR=/Respaldos/inventario
MEGA_ENV=/etc/lospaticas/mega.env
RE='^inventario_[0-9]{8}_[0-9]{4}\.bak$'
RET_CONF=/etc/lospaticas/backup-retencion.conf
retencion_dias() {  # $1 = LOCAL_DIAS | MEGA_DIAS; entero 1-365 de /etc/lospaticas/backup-retencion.conf, si no 14
  local v; v=$(sed -n -E "s/^$1=([0-9]{1,3})[[:space:]]*$/\\1/p" /etc/lospaticas/backup-retencion.conf 2>/dev/null | tail -1)
  if [ -n "$v" ] && [ $((10#$v)) -ge 1 ] && [ $((10#$v)) -le 365 ]; then echo $((10#$v)); else echo 14; fi
}

[ -z "$EXTRA" ] || { echo "comando no permitido" >&2; exit 2; }
con_nombre() {
  [[ "$NOMBRE" =~ $RE ]] || { echo "nombre no permitido" >&2; exit 2; }
}
sin_nombre() {
  [ -z "$NOMBRE" ] || { echo "comando no permitido" >&2; exit 2; }
}
respaldo_en_curso() {
  [ "$(/usr/bin/systemctl show paticas-backup-inventario.service -p ActiveState --value)" = "activating" ]
}

mega_sesion() {
  command -v mega-whoami >/dev/null 2>&1 || { echo "NO_CONFIGURADO falta MEGAcmd"; return 1; }
  [ -r "$MEGA_ENV" ] || { echo "NO_CONFIGURADO faltan credenciales ($MEGA_ENV)"; return 1; }
  if timeout 60 mega-whoami 2>/dev/null | grep -q 'e-mail'; then return 0; fi
  # Sesion caida: login con las credenciales del archivo (mismo metodo que paticas-backup-mega). No imprime secretos.
  (
    set -a; . "$MEGA_ENV"; set +a
    [ -n "${MEGA_USER:-}" ] && [ -n "${MEGA_PASS:-}" ] || exit 1
    TMP=$(mktemp /run/paticas-mega-login.XXXXXX); chmod 600 "$TMP"
    python3 - "$TMP" << 'PY'
import os, sys
q = lambda v: '"' + v.replace("\\", "\\\\").replace('"', '\\"') + '"'
open(sys.argv[1], "w", encoding="utf-8").write(f"login {q(os.environ['MEGA_USER'])} {q(os.environ['MEGA_PASS'])}\nquit\n")
PY
    timeout 120 mega-cmd < "$TMP" >/dev/null 2>&1 || true
    shred -u "$TMP" 2>/dev/null || rm -f "$TMP"
  ) || true
  timeout 60 mega-whoami 2>/dev/null | grep -q 'e-mail' && return 0
  echo "NO_CONFIGURADO no se pudo iniciar sesion en MEGA"; return 1
}


oncalendar_de_token() {
  local t="$1"
  if [[ "$t" =~ ^diaria:([0-9]{2}):([0-9]{2})$ ]]; then
    local h="${BASH_REMATCH[1]}" m="${BASH_REMATCH[2]}"
    [ $((10#$h)) -le 23 ] || return 2
    printf '%s\n' "*-*-* ${h}:${m}:00 America/Costa_Rica"
    return 0
  fi
  if [[ "$t" =~ ^intervalo:minutos:([0-9]{1,2})$ ]]; then
    local n=$((10#${BASH_REMATCH[1]}))
    [ "$n" -ge 1 ] && [ "$n" -le 59 ] || return 2
    printf '%s\n' "*-*-* *:0/${n}:00 America/Costa_Rica"
    return 0
  fi
  if [[ "$t" =~ ^intervalo:horas:([0-9]{1,2})$ ]]; then
    local n=$((10#${BASH_REMATCH[1]}))
    [ "$n" -ge 1 ] && [ "$n" -le 23 ] || return 2
    printf '%s\n' "*-*-* 0/${n}:00:00 America/Costa_Rica"
    return 0
  fi
  if [[ "$t" =~ ^semanal:(Mon|Tue|Wed|Thu|Fri|Sat|Sun):([0-9]{2}):([0-9]{2})$ ]]; then
    local d="${BASH_REMATCH[1]}" h="${BASH_REMATCH[2]}" m="${BASH_REMATCH[3]}"
    [ $((10#$h)) -le 23 ] || return 2
    printf '%s\n' "${d} *-*-* ${h}:${m}:00 America/Costa_Rica"
    return 0
  fi
  return 2
}

aplicar_horario() {
  local unit="$1" cal="$2"
  local dir="/etc/systemd/system/${unit}.timer.d"
  local dest="${dir}/horario.conf"
  mkdir -p "$dir"
  local tmp
  tmp=$(mktemp "${dir}/horario.XXXXXX")
  printf '%s\n' '[Timer]' 'OnCalendar=' "OnCalendar=${cal}" > "$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$dest"
  /usr/bin/systemctl daemon-reload
  # No se reinicia el timer: en systemd 255, restart/try-restart dispara el servicio.
  # daemon-reload recálcula NextElapse si el timer ya estaba activo; si está apagado, no se arranca.
  echo "ONCALENDAR=${cal}"
  /usr/bin/systemctl show "${unit}.timer" --no-pager -p ActiveState -p UnitFileState -p NextElapseUSecRealtime -p LastTriggerUSec -p TimersCalendar
}

case "$ACC" in
  status)
    sin_nombre
    /usr/bin/systemctl show paticas-backup-inventario.timer --no-pager -p ActiveState -p UnitFileState -p NextElapseUSecRealtime -p LastTriggerUSec -p TimersCalendar
    echo '---SERVICE---'
    /usr/bin/systemctl show paticas-backup-inventario.service --no-pager -p ActiveState -p SubState -p Result -p ExecMainStatus -p ExecMainStartTimestamp -p ExecMainExitTimestamp
    echo '---LOG---'
    tail -n 40 /var/log/paticas-backup-inventario.log 2>/dev/null || true
    ;;
  enable)  sin_nombre; /usr/bin/systemctl enable --now paticas-backup-inventario.timer ;;
  disable) sin_nombre; /usr/bin/systemctl disable --now paticas-backup-inventario.timer ;;
  start)
    sin_nombre
    if respaldo_en_curso; then echo "ya esta en curso" >&2; exit 3; fi
    /usr/bin/systemctl start --no-block paticas-backup-inventario.service
    ;;
  schedule)
    [[ "$NOMBRE" =~ ^(diaria:[0-9]{2}:[0-9]{2}|intervalo:(minutos|horas):[0-9]{1,2}|semanal:(Mon|Tue|Wed|Thu|Fri|Sat|Sun):[0-9]{2}:[0-9]{2})$ ]] || { echo "horario no permitido" >&2; exit 2; }
    CAL=$(oncalendar_de_token "$NOMBRE") || { echo "horario no permitido" >&2; exit 2; }
    aplicar_horario paticas-backup-inventario "$CAL"
    ;;
  log)
    sin_nombre
    if [ -r /var/log/paticas-backup-inventario.log ]; then
      tail -c 1500000 /var/log/paticas-backup-inventario.log | tr '\r' '\n' | tail -n 4000
    fi
    ;;
  files)
    sin_nombre
    find "$DIR" -maxdepth 1 -type f -regextype posix-extended -regex '.*/inventario_[0-9]{8}_[0-9]{4}\.bak' -printf '%f\t%s\t%T@\n' | sort
    ;;
  download)
    con_nombre
    F="$DIR/$NOMBRE"
    [ -f "$F" ] && [ ! -L "$F" ] || { echo "no existe" >&2; exit 4; }
    exec /usr/bin/cat -- "$F"
    ;;
  delete)
    con_nombre
    F="$DIR/$NOMBRE"
    [ -f "$F" ] && [ ! -L "$F" ] || { echo "no existe" >&2; exit 4; }
    if respaldo_en_curso; then echo "hay un respaldo en curso; intente cuando termine" >&2; exit 3; fi
    rm -f -- "$F"
    echo "$(TZ=America/Costa_Rica date '+%Y-%m-%d %H:%M:%S') mantenimiento: borrado local $NOMBRE (panel)" >> /var/log/paticas-backup-inventario.log
    echo "borrado $NOMBRE"
    ;;
  espacio)
    sin_nombre
    df -B1 --output=target,size,used,avail "$DIR" | tail -1 | awk '{print "DISK\t"$1"\t"$2"\t"$3"\t"$4}'
    find "$DIR" -maxdepth 1 -type f -regextype posix-extended -regex '.*/inventario_[0-9]{8}_[0-9]{4}\.bak' -printf '%s\n' | awk '{n++; s+=$1} END {print "BACKUP\t" n+0 "\t" s+0}'
    printf 'CARPETA\t%s\n' "$(du -sb "$DIR" | cut -f1)"
    ;;
  mega-espacio)
    sin_nombre
    mega_sesion >&2 || exit 5
    timeout 120 mega-df 2>/dev/null | grep -E 'USED STORAGE|file versions' || true
    ;;
  mega-status)
    sin_nombre
    mega_sesion && echo "OK"
    ;;
  mega-files)
    sin_nombre
    mega_sesion >&2 || exit 5
    # FLAGS VERS SIZE DATE(DDMonYYYY) HH:MM:SS NAME
    timeout 120 mega-ls -l "$MEGA_DIR" 2>/dev/null | while read -r flags vers size d t name extra; do
      [[ "${name:-}" =~ $RE ]] && [ -z "${extra:-}" ] || continue
      [[ "$size" =~ ^[0-9]+$ ]] || continue
      ts=$(TZ=America/Costa_Rica date -d "${d:0:2} ${d:2:3} ${d:5:4} $t" +%s 2>/dev/null || echo 0)
      printf '%s\t%s\t%s\n' "$name" "$size" "$ts"
    done | sort
    ;;
  mega-download)
    con_nombre
    mega_sesion >&2 || exit 5
    exec mega-cat "$MEGA_DIR/$NOMBRE"
    ;;
  mega-delete)
    con_nombre
    mega_sesion >&2 || exit 5
    timeout 120 mega-ls "$MEGA_DIR/$NOMBRE" >/dev/null 2>&1 || { echo "no existe" >&2; exit 4; }
    timeout 120 mega-rm -f "$MEGA_DIR/$NOMBRE"
    echo "$(TZ=America/Costa_Rica date '+%Y-%m-%d %H:%M:%S') mantenimiento: borrado MEGA $NOMBRE (panel)" >> /var/log/paticas-backup-inventario.log
    echo "borrado $NOMBRE"
    ;;
  retencion)
    sin_nombre
    printf 'LOCAL\t%s\nMEGA\t%s\n' "$(retencion_dias LOCAL_DIAS)" "$(retencion_dias MEGA_DIAS)"
    if [ -f "$RET_CONF" ]; then printf 'ACTUALIZADO\t%s\n' "$(stat -c %Y "$RET_CONF")"; fi
    ;;
  retencion-set)
    [[ "$NOMBRE" =~ ^([0-9]{1,3}):([0-9]{1,3})$ ]] || { echo "valor no permitido" >&2; exit 2; }
    L=$((10#${BASH_REMATCH[1]})); M=$((10#${BASH_REMATCH[2]}))
    if [ "$L" -lt 1 ] || [ "$L" -gt 365 ] || [ "$M" -lt 1 ] || [ "$M" -gt 365 ]; then echo "los dias deben estar entre 1 y 365" >&2; exit 2; fi
    TMP=$(mktemp /etc/lospaticas/.backup-retencion.XXXXXX)
    printf '# Dias a mantener los respaldos de inventario (1-365). Lo escribe paticas-backup-ctl retencion-set (panel).\nLOCAL_DIAS=%s\nMEGA_DIAS=%s\n' "$L" "$M" > "$TMP"
    chmod 644 "$TMP"; mv -f "$TMP" "$RET_CONF"
    echo "$(TZ=America/Costa_Rica date '+%Y-%m-%d %H:%M:%S') configuracion: retencion local $L dias, MEGA $M dias (panel; aplica en la proxima corrida)" >> /var/log/paticas-backup-inventario.log
    printf 'LOCAL\t%s\nMEGA\t%s\n' "$L" "$M"
    ;;
  *)
    echo "comando no permitido" >&2
    exit 2
    ;;
esac
