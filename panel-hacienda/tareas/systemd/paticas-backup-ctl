#!/bin/bash
# Comando forzado SSH: status|enable|disable del timer, o start del servicio (una corrida, sin cambiar el horario).
set -euo pipefail
CMD="${SSH_ORIGINAL_COMMAND:-${1:-}}"
CMD=$(printf '%s' "$CMD" | tr -d '\r\n')
case "$CMD" in
  status)
    /usr/bin/systemctl show paticas-backup-inventario.timer --no-pager -p ActiveState -p UnitFileState -p NextElapseUSecRealtime -p LastTriggerUSec
    echo '---SERVICE---'
    /usr/bin/systemctl show paticas-backup-inventario.service --no-pager -p ActiveState -p SubState -p Result -p ExecMainStatus -p ExecMainStartTimestamp -p ExecMainExitTimestamp
    echo '---LOG---'
    tail -n 40 /var/log/paticas-backup-inventario.log 2>/dev/null || true
    ;;
  enable)
    /usr/bin/systemctl enable --now paticas-backup-inventario.timer
    ;;
  disable)
    /usr/bin/systemctl disable --now paticas-backup-inventario.timer
    ;;
  start)
    state=$(/usr/bin/systemctl show paticas-backup-inventario.service -p ActiveState --value)
    if [ "$state" = "activating" ]; then
      echo "ya esta en curso" >&2
      exit 3
    fi
    /usr/bin/systemctl start --no-block paticas-backup-inventario.service
    ;;
  log)
    if [ -r /var/log/paticas-backup-inventario.log ]; then
      tail -c 1500000 /var/log/paticas-backup-inventario.log | tr '\r' '\n' | tail -n 4000
    fi
    ;;
  *)
    echo "comando no permitido" >&2
    exit 2
    ;;
esac
