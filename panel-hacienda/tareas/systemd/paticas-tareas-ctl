#!/bin/bash
# Control estrecho de timers de tareas (3 locales en .106 + respaldo en .100).
# Uso: paticas-tareas-ctl <caja_correo|mensajeria_update|prefacturas_update|backup_inventario> <enable|disable|start|status|log>
# start lanza el servicio una vez (--no-block) y no cambia el timer.
set -euo pipefail
ID="${1:-}"
ACC="${2:-}"
case "$ID" in
  caja_correo|mensajeria_update|prefacturas_update|backup_inventario) ;;
  *) echo "unidad invalida" >&2; exit 2 ;;
esac
case "$ACC" in
  enable|disable|start|status|log) ;;
  *) echo "accion invalida" >&2; exit 2 ;;
esac

if [ "$ID" = "backup_inventario" ]; then
  exec /usr/bin/ssh -F /dev/null -i /etc/lospaticas/ssh/paticas-backup-inventario \
    -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes \
    -o UserKnownHostsFile=/etc/lospaticas/ssh/known_hosts \
    -o ConnectTimeout=15 \
    administrator@172.16.12.100 "$ACC"
fi

declare -A UNIT=(
  [caja_correo]=paticas-caja-correo
  [mensajeria_update]=paticas-mensajeria-update
  [prefacturas_update]=paticas-prefacturas-update
)
U="${UNIT[$ID]}"
case "$ACC" in
  enable)  exec /usr/bin/systemctl enable --now "${U}.timer" ;;
  disable) exec /usr/bin/systemctl disable --now "${U}.timer" ;;
  start)
    state=$(/usr/bin/systemctl show "${U}.service" -p ActiveState --value)
    if [ "$state" = "activating" ]; then
      echo "ya esta en curso" >&2
      exit 3
    fi
    exec /usr/bin/systemctl start --no-block "${U}.service"
    ;;
  status)
    /usr/bin/systemctl show "${U}.timer" --no-pager -p ActiveState -p UnitFileState -p NextElapseUSecRealtime -p LastTriggerUSec
    echo '---SERVICE---'
    /usr/bin/systemctl show "${U}.service" --no-pager -p ActiveState -p SubState -p Result -p ExecMainStatus -p ExecMainStartTimestamp -p ExecMainExitTimestamp
    echo '---LOG---'
    LOG="/var/log/lospaticas/${U#paticas-}.log"
    tail -n 40 "$LOG" 2>/dev/null || true
    ;;
esac
