[Unit]
Description=Los Paticas - reset existencias de mensajeria (utilitarios/mensajeria_update.php)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
UMask=0027
StandardOutput=append:/var/log/lospaticas/mensajeria-update.log
StandardError=append:/var/log/lospaticas/mensajeria-update.log
ExecStart=/usr/bin/php8.5 /var/www/lospaticas/sistema/utilitarios/mensajeria_update.php
Nice=5
NoNewPrivileges=yes
PrivateTmp=yes
