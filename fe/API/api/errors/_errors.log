         FROM  DOC_ELECTRONICO_PROCESADO  d
        WHERE (DATALENGTH( d.XML_RESPUESTA) < 6  OR d.XML_RESPUESTA is NULL)
        AND  d.FECHATIMBRADO  >= '2019-07-01'
        ORDER BY d.FECHATIMBRADO ASC

