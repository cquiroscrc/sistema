[d] 20-07-23 07:07:42 @ SELECT   TOP 10 V.TIPO_DOCUMENTO, V.DOCUMENTO, V.NIT, case V.CORREO when '1' then 'facturaelectronica@lospaticas.com' else correo end as CORREO,
                         V.GLN,v.CLAVE,v.SAT
                         FROM V_DOCUMENTO_ELECTRONICO v
                         LEFT JOIN DOC_ELECTRONICO_PROCESADO p
                         ON v.DOCUMENTO=p.NUMERO_DOC
                         WHERE v.ACEPTA_DOC_ELECTRONICO = 'S' AND v.NIT NOT IN ('3101090358')
                         AND (p.ENVIADO='S' AND p.ACEPTADO='N')
                         AND V.TIPO_DOCUMENTO IN ('FE','NC','ND','TE')
                         AND V.TIPO_DOCUMENTO IN ('FE')
                         AND NOT v.SAT is NULL
                         and v.FECHA >= '01/07/2019'
                        OR (
                               ENVIADO is NULL AND ACEPTADO is NULL  and v.FECHA >= '01/07/2019'
                               AND v.ACEPTA_DOC_ELECTRONICO = 'S' AND v.NIT NOT IN('3101090358')
                               AND V.TIPO_DOCUMENTO IN('FE', 'NC', 'ND', 'TE')
                               AND V.TIPO_DOCUMENTO IN('FE')
                           )
                        OR (
                               ENVIADO ='N'  and v.FECHA >= '01/07/2019'
                               AND v.ACEPTA_DOC_ELECTRONICO = 'S' AND v.NIT NOT IN('3101090358')
                               AND V.TIPO_DOCUMENTO IN('FE', 'NC', 'ND', 'TE')
                               AND V.TIPO_DOCUMENTO IN('FE')
                           )
                         ORDER BY v.DOCUMENTO
